# Copy to .env for a local environment; never commit real credentials.
ENVIRONMENT=development
APP_NAME=Chronickel
APP_PUBLIC_ORIGIN=https://chronickel.example.com
APP_DB_PASSWORD=change-me-local-only
APP_JWT_SECRET=change-me-to-a-unique-local-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=
