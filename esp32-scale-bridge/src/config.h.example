// FitTrack Scale Bridge — Configuration
// Copy this file to config.h and fill in your values.
// NEVER commit config.h with real credentials.

#ifndef CONFIG_H
#define CONFIG_H

// --- WiFi ---
#define WIFI_SSID       "YOUR_HOME_WIFI"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// --- FitTrack API ---
// Use the public URL since networks are separate
#define API_HOST        "fittrack.49.12.225.84.sslip.io"
#define API_PORT        443
#define API_PATH        "/api/scale-sync"
#define API_KEY         "YOUR_FITTRACK_CLI_KEY"  // must match FITTRACK_CLI_KEY env var on server
// ESP32 sends this as X-FitTrack-CLI-Key header (same auth as CLI)

// --- User profile (for server-side body composition calculation) ---
#define USER_HEIGHT_CM  180   // your height in cm
#define USER_AGE        30    // your age
#define USER_GENDER     "male"  // "male" or "female"

// --- RENPHO ES-CS20M AABB broadcast scale ---
// The AABB variant does not accept GATT connections. Copy the address emitted
// by the diagnostic, for example "ed:67:39:73:66:35".
#define SCALE_BLE_ADDRESS "ed:67:39:73:66:35"

// --- Timing ---
#define BLE_SCAN_DURATION  30    // seconds to scan for scale
#define HTTP_TIMEOUT       10000 // ms
#define RECONNECT_DELAY    5000  // ms between reconnect attempts

#endif // CONFIG_H
