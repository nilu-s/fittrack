#!/usr/bin/env bash
set -euo pipefail

# The checked-in snapshot is a reviewable API contract. Generate it only from
# the application currently under test; never hand-edit the JSON.
cd "$(dirname "$0")/../backend"
python -c 'import json; from pathlib import Path; from app.main import app; Path("../docs/contracts/openapi.json").write_text(json.dumps(app.openapi(), indent=2, ensure_ascii=False) + "\n", encoding="utf-8")'
