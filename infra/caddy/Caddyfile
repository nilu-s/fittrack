{$FITTRACK_CADDY_SITE} {
  encode gzip zstd

  @google_public path /api/google/callback /api/auth/google/login
  handle @google_public {
    reverse_proxy fittrack-api:8000
  }

  @api path /api/*
  handle @api {
    basic_auth {
      {$FITTRACK_CADDY_AUTH_USER} {$FITTRACK_CADDY_AUTH_HASH}
    }
    reverse_proxy fittrack-api:8000
  }

  handle {
    basic_auth {
      {$FITTRACK_CADDY_AUTH_USER} {$FITTRACK_CADDY_AUTH_HASH}
    }
    reverse_proxy fittrack-web:3000
  }
}

buzz.49.12.225.84.sslip.io {
  encode gzip zstd

  @buzz_pair path /pair /pair/*
  handle @buzz_pair {
    reverse_proxy buzz-pairing:5000
  }

  handle {
    reverse_proxy buzz-relay:3000
  }
}

{$HERMES_PREVIEW_DOMAIN} {
  encode gzip zstd

  @hidden path_regexp hidden (^|/)[.]
  @secret path_regexp secret (?i)(^|/)([^/]+[.](env|pem|key|crt|p12|pfx|sqlite|sqlite3|db|log))$
  respond @hidden 404
  respond @secret 404

  root * /srv/hermes/previews
  header {
    Cache-Control "no-store"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
  }
  try_files {path} {path}/index.html
  file_server
}
