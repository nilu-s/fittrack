#!/usr/bin/env python3
"""Copy the narrow Codex credential into Cronicl's rotation-safe mount."""

import json
import os
from pathlib import Path
import sys
import tempfile

SOURCE = Path("/root/.codex/auth.json")
TARGET_DIR = Path("/root/.local/share/cronicl/codex-auth")
TARGET = TARGET_DIR / "auth.json"


def main() -> None:
    # Validate only the required shape. Never print or log credential content.
    document = json.loads(SOURCE.read_text(encoding="utf-8"))
    tokens = document.get("tokens") if isinstance(document, dict) else None
    access_token = tokens.get("access_token") if isinstance(tokens, dict) else None
    if not isinstance(access_token, str) or not access_token:
        raise ValueError("Codex credential has no access token")

    TARGET_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(TARGET_DIR, 0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".auth.json.", dir=TARGET_DIR)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as temporary:
            json.dump({"tokens": {"access_token": access_token}}, temporary, separators=(",", ":"))
            temporary.flush()
            os.fsync(temporary.fileno())
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, TARGET)
    finally:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("Codex credential synchronization failed", file=sys.stderr)
        raise SystemExit(1) from None
